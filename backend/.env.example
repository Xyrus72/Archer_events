# Archer Events API — copy to backend/.env and fill in as you go.

# ── Database ── left blank on purpose: the API runs on an in-memory store until you
# paste a MongoDB connection string here (Atlas: Connect → Drivers → copy the URI).
MONGODB_URI=
# Database name — optional; taken from the URI path when present, else "archer"
MONGODB_DB=archer

# ── Security ──
# Long random secret for /admin and /api/admin. Empty = the ticket office is OPEN (dev only!)
ADMIN_KEY=
# Signs session cookies (long random string). Unset = everyone is signed out on restart.
SESSION_SECRET=

# ── Behaviour ──
# 1 = fill the in-memory store with fake events, registrations and demo logins (ignored with MongoDB)
DEMO_DATA=
# API port (Vite proxies /api and /uploads here in dev)
PORT=4000
# Public registration POSTs allowed per IP per 10 minutes (default 20)
RATE_LIMIT_MAX=20
# "sandbox" (default, moves no money) until a real provider is wired into routes/pay.js
PAYMENT_GATEWAY=sandbox
